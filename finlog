#!/usr/bin/env bash

# finlog: a Bash script for recording and listing personal expenses in a local
# SQLite database.

set -u

# --- Configuration ---

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

# --- Helper Functions ---

die() {
  local msg="$1"
  local code="${2:-1}"
  echo "[$SCRIPT_NAME:${BASH_LINENO[0]}] ERROR: $msg" >&2
  exit "$code"
}

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$@" >&2
}

usage() {
  echo "$SCRIPT_NAME: usage:"
  echo "$SCRIPT_NAME -h displays this help text."
  echo "$SCRIPT_NAME {add | delete | list | summary}:"
  echo "  add       Add a transaction."
  echo "            Usage: finlog add [date] amount category [-n note]"
  echo "  delete    Delete a transaction."
  echo "            Usage: finlog delete transaction_number"
  echo "  list      List all transactions, or list by \
date/amount/category/notes."
  echo "            Wildcards: '%' and '_'."
  echo "            Usage: finlog list {all | -d [date] | -a amount | \
-c category | -n note}"
  echo "  summary   Display the total amount spent per category."
  echo "            Usage: finlog summary"
}

# =============================================================================
# Main Logic
# =============================================================================

# --- Initial Input Validation ---

if (( $# == 0 )); then
  die "missing arguments/options; use '$SCRIPT_NAME -h' for help."
fi

# --- Check for Help Request ---

while getopts :h opt; do
  case "$opt" in
    h)  usage
        exit 0
        ;;
    \?) die "option '-$OPTARG' not valid; use 'finlog -h' for help."
        ;;
  esac
done

# --- Exit on Invalid Argument ---

case "$1" in
  add|delete|list|summary)  
    ;;
  *)
    die "argument '$1' not valid; use 'finlog -h' for help."
    ;;
esac

# --- Dependency Check ---

if ! command -v sqlite3 >&2 >/dev/null; then
  die "SQLite3 not installed."
fi

# --- Configuration Parameters for Main Logic ---

readonly DB_PATH="$HOME/.local/share/finlog"
readonly DB_FILE="finlog.db"

readonly SQLITE_CONFIG=(
  -cmd ".header on"
  -cmd ".mode box"
  -cmd ".width 3 10 -12 16 29"
)

readonly SQLITE_OUTPUT_FORMAT="id AS ID, date AS Date, 'kr ' \
  || printf('%d,%02d', amount / 100, amount % 100) AS Amount, \
  category AS Category, note AS Note"

# --- Working Directory and Database File Checks ---

if [[ ! -d "$DB_PATH" ]]; then
  mkdir -p "$DB_PATH" \
    || die "unable to create directory $DB_PATH."
fi

if [[ -f "$DB_PATH/$DB_FILE" ]] \
  && [[ ! -w "$DB_PATH/$DB_FILE" ]]; then
  die "unable to write to database file $DB_PATH/$DB_FILE."
fi

if [[ ! -f "$DB_PATH/$DB_FILE" ]]; then
  sqlite3 "$DB_PATH/$DB_FILE" "CREATE TABLE finlog_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT,
    amount INTEGER,
    category TEXT,
    note TEXT)" \
      || die "unable to create database file $DB_PATH/$DB_FILE."
  log "Database file $DB_PATH/$DB_FILE successfully created."
fi 

# --- SQLite Functions ---

add_note=0

finlog_add () {

  if [[ "$add_note" == 0 ]]; then
    sqlite3 "$DB_PATH/$DB_FILE" "INSERT INTO finlog_data (
    date, amount, category)
    VALUES ('$tx_date', $tx_amount,'$tx_category')" \
      || die "unable to write to database file $DB_PATH/$DB_FILE."
  else
    sqlite3 "$DB_PATH/$DB_FILE" "INSERT INTO finlog_data (
    date, amount, category, note)
    VALUES ('$tx_date', $tx_amount,'$tx_category','$tx_note')" \
      || die "unable to write to database file $DB_PATH/$DB_FILE."
  fi
  
  printf "\n" 
  log "Transaction successfully added:"
  
  printf "\n"
  sqlite3 "${SQLITE_CONFIG[@]}" \
    "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
    WHERE id = (SELECT MAX(id) FROM finlog_data)"
  printf "\n"

}

finlog_delete () {

  delete_tx () {
    sqlite3 "${SQLITE_CONFIG[@]}" \
    "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
    WHERE rowid = $tx_id"
  }

  if [[ -z "$(delete_tx)" ]]; then
    die "transaction $tx_id does not exist."
  fi

  printf "\n%s\n\n" "The following transaction will be deleted:"
  delete_tx
  printf "\n"
  read -rp "Are you sure? (y/n) > "

  if [[ ! "$REPLY" =~ ^[yY]$ ]]; then
    die "program terminated by user."
  fi

  sqlite3 "$DB_PATH/$DB_FILE" "DELETE FROM finlog_data WHERE rowid = $tx_id" \
    || die "unable to delete transaction $tx_id."

  printf "\n"
  log "Transaction $tx_id successfully deleted."
  printf "\n"

}

list_all=0
list_date=0
list_amount=0
list_category=0
list_note=0

finlog_list () {
  
  sum_validation () {

    local sum_total
    sum_total="$(sqlite3 "$DB_PATH/$DB_FILE" "SELECT 'kr ' || printf('%d,%02d',
    SUM(amount) / 100, SUM(amount) % 100) FROM finlog_data WHERE $1
    LIKE '$2'")"
  
    if [[ "$sum_total" = 'kr 0,00' ]]; then
      die "no matching transactions."
    else
      printf "\n"
      echo "Sum Total: $sum_total"
      printf "\n"
    fi
  }

  if (( list_all == 1 )); then

    printf "\n"
    sqlite3 "${SQLITE_CONFIG[@]}" \
      "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data"
  
    sum_validation id '%'

  elif (( list_date == 1 )); then

    printf "\n"
    sqlite3 "${SQLITE_CONFIG[@]}" \
      "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
      WHERE date LIKE '$tx_date'"

      sum_validation date "$tx_date"

  elif (( list_amount == 1 )); then
  
    printf "\n"
    sqlite3 "${SQLITE_CONFIG[@]}" \
      "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
      WHERE amount LIKE '$tx_amount'"

      sum_validation amount "$tx_amount"

  elif (( list_category == 1 )); then
    
    printf "\n" 
    sqlite3 "${SQLITE_CONFIG[@]}" \
      "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
      WHERE category LIKE '$tx_category'"

    sum_validation category "$tx_category"

  elif (( list_note == 1 )); then

    printf "\n"
    sqlite3 "${SQLITE_CONFIG[@]}" \
      "$DB_PATH/$DB_FILE" "SELECT $SQLITE_OUTPUT_FORMAT FROM finlog_data
      WHERE note LIKE '$tx_note'"

    sum_validation note "$tx_note"

  fi

}

finlog_summary () {
  
  printf "\n"
  sqlite3 -cmd ".header on" -cmd ".mode box" -cmd ".width 16 -12" \
    "$DB_PATH/$DB_FILE" "SELECT category AS Category, 'kr ' || printf('%d,%02d',
    SUM(amount) / 100, SUM(amount) % 100) AS Total FROM finlog_data
    GROUP BY category"
  
  sum_total="$(sqlite3 "$DB_PATH/$DB_FILE" "SELECT 'kr ' ||
  printf('%d,%02d', SUM(amount) / 100, SUM(amount) % 100) FROM finlog_data")"
  
  if [[ "$sum_total" = 'kr 0,00' ]]; then
    die "no transactions in database."
  else
    printf "\n"
    echo "Sum Total: $sum_total"
    printf "\n"
  fi

}

# --- User Input Validation and Conversion ---

validate_date () {
  IFS='.' read -r tx_d tx_m tx_Y <<< "$tx_date"
  tx_date="$(printf "%s-%s-%s" "$tx_Y" "$tx_m" "$tx_d")"
  if [[ ! "$tx_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
    || ! date -d "$tx_date" >/dev/null 2>&1; then
      die "invalid date; use DD.MM.YYYY."
  fi
}

validate_amount () {
  if [[ ! "$tx_amount" =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
    die "invalid amount; digits only, 0/2 decimals, ',' as decimal separator."
  elif (( tx_amount == 0 )); then
    die "invalid amount: zero."
  fi
  tx_amount="${tx_amount//,/.}"
  tx_amount="$(awk -v amt="$tx_amount" 'BEGIN { printf "%.0f", amt * 100 }')"
}

validate_category () {
  if [[ ! "$tx_category" =~ ^[[:alnum:]]+$ ]]; then
    die "invalid category; single word only, alphanumeric characters."
  fi
}

validate_category_search () {
  if [[ ! "$tx_category" =~ ^[[:alnum:]%_]+$ ]]; then
    die "search allows alphanumeric characters and '%_'."
  fi
}

validate_note () {
  tx_note="${tx_note:-}"
  if [[ ! "$tx_note" =~ ^[[:alnum:]\ .,!?:/_()]+$ ]] && [[ -n "$tx_note" ]]; then
    die "invalid note; Only alphanumerics, space and '.,!?:/_()' allowed."
  fi
}

validate_note_search () {
  tx_note="${tx_note:-}"
  if [[ ! "$tx_note" =~ ^[[:alnum:]\ .,!?:/_%()]+$ ]] && [[ -n "$tx_note" ]]; then
    die "search allows alphanumerics, space and '.,!?:/_%()'."
  fi
}
validate_tx_id () {
  if [[ ! "$tx_id" =~ ^[0-9]+$ ]]; then
    die "invalid transaction number; digits only, no spaces."
  fi
}

# --- Secondary Argument/Option Validation ---

optval="${2:-}"

optval_check () {
if [[ -z "$optval" ]]; then
  die "missing arguments/options; use '$SCRIPT_NAME -h' for help."
fi
}

# --- Argument/Option Parsing ---

case "$1" in
  add)      optval_check
            shift
            tx_data=("$@")
            if [[ "${tx_data[0]}" =~ ^[0-9]{2}\.[0-9]{2}\.[0-9]{4}$ ]]; then
              tx_date="${tx_data[0]}"
              tx_amount="${tx_data[1]}"
              tx_category="${tx_data[2]}"
              if (( ${#tx_data[@]} >= 4 )) && [[ "${tx_data[3]}" == -n ]]; then
                add_note=1
                tx_note="${tx_data[*]:4}"
              fi
            elif [[ "${tx_data[0]}" =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
              tx_date="$(date +"%d.%m.%Y")"
              tx_amount="${tx_data[0]}"
              tx_category="${tx_data[1]}"
              if (( ${#tx_data[@]} >= 3 )) && [[ "${tx_data[2]}" == -n ]]; then
                add_note=1
                tx_note="${tx_data[*]:3}"
              fi
            else
              die "invalid input '${tx_data[0]}'; '$SCRIPT_NAME -h' for help."
            fi
            validate_date
            validate_amount
            validate_category
            validate_note 
            finlog_add
            ;;
  delete)   optval_check
            tx_id="$2"
            validate_tx_id
            finlog_delete
            ;;
  list)     optval_check
            case "$2" in
              all)  list_all=1
                    ;;
              -d)   list_date=1
                    tx_date="${3:-$(date +"%d.%m.%Y")}"
                    validate_date
                    ;;
              -a)   list_amount=1
                    tx_amount="${3:-}"
                    validate_amount
                    ;;
              -c)   list_category=1
                    tx_category="${3:-}"
                    validate_category_search
                    ;;
              -n)   list_note=1
                    shift 2
                    tx_note="$*"
                    validate_note_search
                    ;;
              *)    die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
                    ;;
            esac
            finlog_list
            ;;
  summary)  finlog_summary
            ;;
  *)        die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
            ;;
esac
