# --- Main Logic ---

if ! which sqlite3; then
  die "SQLite3 not installed."
fi

DB_PATH="$HOME/.local/share/finlog"
DB_FILE="finlog.db"

if [[ ! -d $DB_PATH ]]; then
  mkdir -p "$DB_PATH" \
    || die "unable to create directory $DB_PATH."
fi

if [[ -f $DB_PATH/$DB_FILE ]] \
  && [[ ! -w $DB_PATH/$DB_FILE ]]; then
  die "unable to write to database file $DB_PATH/$DB_FILE."
fi

if [[ ! -f $DB_PATH/$DB_FILE ]]; then
  sqlite3 "$DB_PATH/$DB_FILE" "CREATE TABLE finlog_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT,
    amount INTEGER,
    category TEXT,
    note TEXT)" \
      || die "unable to create database file $DB_PATH/$DB_FILE."
  log "Database file $DB_PATH/$DB_FILE successfully created."
fi 
