# --- Main Logic ---

while getopts :h opt; do
  case $opt in
    h)  usage
        exit 0
        ;;
    \?) die "option '-$optarg' not valid; use '$SCRIPT_NAME -h' for help." ;;
  esac
done

if ! which sqlite3; then
  die "SQLite3 not installed."
fi

DB_PATH="$HOME/.local/share/finlog"
DB_FILE="finlog.db"

if [[ ! -d $DB_PATH ]]; then
  mkdir -p "$DB_PATH" \
    || die "unable to create directory $DB_PATH."
fi

if [[ -f $DB_PATH/$DB_FILE ]] \
  && [[ ! -w $DB_PATH/$DB_FILE ]]; then
  die "unable to write to database file $DB_PATH/$DB_FILE."
fi

if [[ ! -f $DB_PATH/$DB_FILE ]]; then
  sqlite3 "$DB_PATH/$DB_FILE" "CREATE TABLE finlog_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT,
    amount INTEGER,
    category TEXT,
    note TEXT)" \
      || die "unable to create database file $DB_PATH/$DB_FILE."
  log "Database file $DB_PATH/$DB_FILE successfully created."
fi 

finlog_add () {
  
  IFS='.' read -r tx_day tx_month tx_year <<< "$tx_date"
  tx_date_iso=$(printf "%s-%s-%s" "$tx_year" "$tx_month" "$tx_day")

  if [[ ! $tx_date_iso =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
    && ! date -d "$tx_date_iso" >/dev/null 2>&1; then
    die "invalid date; use DD.MM.YYYY."
  fi

  if [[ ! $tx_amount =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
    die "invalid amount; digits only, 0/2 decimals, ',' as decimal separator."
  fi

  if [[ ! $tx_category =~ ^[[:alnum:]]+$ ]]; then
    die "invalid category: single word only, alphanumeric characters."
  fi

  if [[ ! $tx_note =~ ^[A-Za-z0-9\ .,!?:/_()]+$ ]]; then
    die "invalid notes: Only A-Z, a-z, 0-9, space and '.,!?:/_()' allowed."
  fi

  sqlite3 "$DB_PATH/$DB_FILE" "INSERT INTO finlog_data (
    date, amount, category, note)
    VALUES ('$tx_date_iso', $tx_amount,'$tx_category','$tx_note')" \
      || die "unable to write to database file $DB_PATH/$DB_FILE."
  
  sqlite3 -cmd ".header on" -cmd ".mode box" -cmd ".width -10 10 10 40 60" \
    "$DB_PATH/$DB_FILE"

}

finlog_delete () {
  true
}

finlog_list () {
  true
}

finlog_summary () {
  true
}

case "$1" in
  add)      while [[ $# -gt 0 ]]; do 
              tx_date="$2:-$(date +"%d.%m.%Y")"
              shift
              tx_amount="$2"
              shift
              tx_category="$2"
              shift
              tx_note="$@"
            done
            tx_note="${tx_note//\'/\'\'}"
            finlog_add
            ;;
  delete)   tx_id="$2"
            finlog_delete
            ;;
  list)     case "$2" in
              all)  # sqlite3 command here
                    ;;
              -d)   list_date="$3:-$(date +"%d.%m.%Y")"
                    ;;
              -a)   list_amount="$3"
                    ;;
              -c)   list_category="$3"
                    ;;
              -n)   list_note="$3"
                    ;;
              *)    die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
                    ;;
            esac
            finlog_list
            ;;
  summary)  finlog_summary
            ;;
  *)        die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
            ;;
esac
