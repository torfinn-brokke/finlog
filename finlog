#!/usr/bin/env bash

# finlog: a Bash script for recording and listing personal expenses in a local
# SQLite database.

set -uo pipefail

# --- Configuration ---

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

# --- Helper Functions ---

die() {
  local msg="$1"
  local code="${2:-1}"
  echo "[$SCRIPT_NAME:${BASH_LINENO[0]}] ERROR: $msg" >&2
  exit "$code"
}

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$@" >&2
}

# usage() {
#   echo "$SCRIPT_NAME: usage:"
#   echo "$SCRIPT_NAME [source_directory destination_directory]"
#   echo "  -d  Dry-run mode"
#   echo "  -h  Help"
# }

# =============================================================================
# Main Logic
# =============================================================================

# --- Initial Input Validation ---

if (( $# == 0 )); then
  die "missing arguments/options; use '$SCRIPT_NAME -h' for help."
fi

# --- Dependency Check ---

if ! which sqlite3; then
  die "SQLite3 not installed."
fi

# --- Configuration Parameters for Main Logic ---

readonly DB_PATH="$HOME/.local/share/finlog"
readonly DB_FILE="finlog.db"
readonly SQLITE_CONFIG="-cmd \".header on\" -cmd \".mode box\" \
  -cmd \".width -10 10 10 40 60\""

# --- Working Directory and Database File Checks ---

if [[ ! -d $DB_PATH ]]; then
  mkdir -p "$DB_PATH" \
    || die "unable to create directory $DB_PATH."
fi

if [[ -f $DB_PATH/$DB_FILE ]] \
  && [[ ! -w $DB_PATH/$DB_FILE ]]; then
  die "unable to write to database file $DB_PATH/$DB_FILE."
fi

if [[ ! -f $DB_PATH/$DB_FILE ]]; then
  sqlite3 "$DB_PATH/$DB_FILE" "CREATE TABLE finlog_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    date TEXT,
    amount INTEGER,
    category TEXT,
    note TEXT)" \
      || die "unable to create database file $DB_PATH/$DB_FILE."
  log "Database file $DB_PATH/$DB_FILE successfully created."
fi 

# --- SQLite Functions ---

finlog_add () {

  if [[ ! $tx_date_iso =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
    || ! date -d "$tx_date_iso" >/dev/null 2>&1; then
    die "invalid date; use DD.MM.YYYY."
  fi

  if [[ ! $tx_amount =~ ^[0-9]+$ ]]; then
    die "invalid amount; digits only, 0/2 decimals, ',' as decimal separator."
  fi

  if [[ ! $tx_category =~ ^[[:alnum:]]+$ ]]; then
    die "invalid category: single word only, alphanumeric characters."
  fi

  if [[ ! $tx_note =~ ^[[:alnum:]\ .,!?:/_()]+$ ]]; then
    die "invalid notes: Only alphanumerics, space and '.,!?:/_()' allowed."
  fi

  sqlite3 "$DB_PATH/$DB_FILE" "INSERT INTO finlog_data (
    date, amount, category, note)
    VALUES ('$tx_date_iso', $tx_amount,'$tx_category','$tx_note')" \
      || die "unable to write to database file $DB_PATH/$DB_FILE."
  
  log "Transaction successfully added:"

  sqlite3 "$SQLITE_CONFIG" \
    "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data
    WHERE rowid = last_insert_rowid()"

}

finlog_delete () {

  if [[ ! $tx_id =~ ^[0-9]+$ ]]; then
    die "invalid transaction number; digits only, no spaces."
  fi

  printf "%s\n\n" "The following transaction will be deleted:"
  sqlite3 "$SQLITE_CONFIG" \
    "$DB_PATH/$DB_FILE" "SELECT * FROM finlog data
    WHERE rowid = $tx_id"
  printf "\n"
  read -rp "Are you sure? (y/n) > "

  if [[ ! $REPLY =~ ^[yY]$ ]]; then
    log "Program terminated."
  fi

  sqlite3 "$DB_PATH/$DB_FILE" "DELETE FROM finlog_data WHERE rowid = $tx_id" \
    || die "unable to delete transaction $tx_id."

  log "Transaction $tx_id successfully deleted."

}

finlog_list () {
  
  local list_all=0
  local list_date=0
  local list_amount=0
  local list_category=0
  local list_note=0

  if (( list_all == 1 )); then

    sqlite3 "$SQLITE_CONFIG" \
      "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data"

  elif (( list_date != 0 )); then

    if [[ ! $list_date_iso =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
      || ! date -d "$list_date_iso" >/dev/null 2>&1; then
      die "invalid date; use DD.MM.YYYY."
    fi
  
    sqlite3 "$SQLITE_CONFIG" \
      "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data
      WHERE date LIKE '$list_date'"

  elif (( list_amount != 0 )); then
  
    if [[ ! $list_amount =~ ^[0-9]+$ ]]; then
      die "invalid amount; digits only, 0/2 decimals, ',' as decimal separator."
    fi

    sqlite3 "$SQLITE_CONFIG" \
      "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data
      WHERE amount LIKE '$list_amount'"

  elif (( list_category != 0 )); then
    
    if [[ ! $list_category =~ ^[[:alnum:]]+$ ]]; then
      die "invalid category: single word only, alphanumeric characters."
    fi

    sqlite3 "$SQLITE_CONFIG" \
      "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data
      WHERE category LIKE '$list_category'"

  elif (( list_note != 0 )); then
    if [[ ! $list_note =~ ^[[:alnum:]\ .,!?:/_()]+$ ]]; then
      die "invalid notes: Only alphanumerics, space and '.,!?:/_()' allowed."
    fi

    sqlite3 "$SQLITE_CONFIG" \
      "$DB_PATH/$DB_FILE" "SELECT * FROM finlog_data
      WHERE note LIKE '$list_note'"

  fi

}

finlog_summary () {
  true
}

# --- Argument/Option Parsing ---

case "$1" in
  -h)       usage
            exit 0
            ;;
  add)      if [[ $2 =~ ^[0-9]{2}\.[0-9]{2}\.[0-9]{4}$ ]]; then
              while [[ $# -gt 0 ]]; do 
                tx_date="$2:-$(date +"%d.%m.%Y")"
                IFS='.' read -r tx_d tx_m tx_Y <<< "$tx_date"
                tx_date_iso=$(printf "%s-%s-%s" "$tx_Y" "$tx_m" "$tx_d")
                shift
                tx_amount="$2"
                if [[ ! $tx_amount =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
                  die "invalid amount; digits only, 0/2 decimals, \
                    ',' as decimal separator."
                fi
                ${tx_amount//,/} 
                shift
                tx_category="$2"
                shift
                tx_note="$*"
              done
            else
              while [[ $# -gt 0 ]]; do 
                tx_amount="$2"
                if [[ ! $tx_amount =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
                  die "invalid amount; digits only, 0/2 decimals, \
                    ',' as decimal separator."
                fi
                shift
                tx_category="$2"
                shift
                tx_note="$*"
              done
            fi
            tx_note="${tx_note//\'/\'\'}"
            finlog_add
            ;;
  delete)   tx_id="$2"
            finlog_delete
            ;;
  list)     case "$2" in
              all)  list_all=1
                    ;;
              -d)   set +u
                    unset list_date
                    list_date="$3:-$(date +"%d.%m.%Y")"
                    set -u
                    IFS='.' read -r ls_d ls_m ls_Y <<< "$tx_date"
                    list_date_iso=$(printf "%s-%s-%s" "$ls_Y" "$ls_m" "$ls_d")
                    ;;
              -a)   list_amount="$3"
                    if [[ ! $list_amount =~ ^[0-9]+,?([0-9]{2})?$ ]]; then
                      die "invalid amount; digits only, 0/2 decimals, \
                        ',' as decimal separator."
                    fi
                    list_amount="${list_amount//,/}"
                    ;;
              -c)   list_category="$3"
                    ;;
              -n)   list_note="$3"
                    ;;
              *)    die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
                    ;;
            esac
            finlog_list
            ;;
  summary)  finlog_summary
            ;;
  *)        die "invalid argument(s); use '$SCRIPT_NAME -h' for help."
            ;;
esac
